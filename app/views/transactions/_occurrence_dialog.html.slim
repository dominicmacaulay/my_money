dialog.modal aria-labelledby="#{id}-title" data-dialog-target='dialog' data-action='click->dialog#closeOnBackdrop'
  .modal__header
    span id="#{id}-title" = title
    = button_tag material_icon('close', size: 'x-large', hover_text: 'Close'), type: 'button', class: 'btn btn--no-border btn--icon btn--pill', aria: { label: 'Close' }, data: { action: 'dialog#close' }

  .modal__body
    p This transaction is part of a recurring series. Apply this to only this transaction, or to it and every later one?

  .modal__footer.flex.flex-wrap.justify-end.gap-xs
    = yield
