-# locals: (report:)

- if report.any_transactions?
  - months = report.monthly_breakdown
  - income = months.map { |month| month.income.to_f }
  - expense = months.map { |month| month.expense.to_f }

  .monthly-chart[data-controller="monthly-chart"
                 data-monthly-chart-labels-value=months.map(&:name).to_json
                 data-monthly-chart-income-value=income.to_json
                 data-monthly-chart-expense-value=expense.to_json
                 data-monthly-chart-currency-value=Money.default_currency.iso_code]
    .monthly-chart__plot
      canvas data-monthly-chart-target="canvas"

    table.sr-only
      caption = "#{report.year} income and expenses by month"
      thead
        tr
          th Month
          th Income
          th Expenses
      tbody
        - months.each do |month|
          tr
            th = month.name
            td = humanized_money_with_symbol(month.income)
            td = humanized_money_with_symbol(month.expense)

- else
  .text-center.margin-md
    i No transactions for this year yet.
