.page-header
  h1 View your financial data by year

.divider

.year-overviews
  - @year_presenter.years.each do |year|
    details.accordion open=(year == Date.current.year) data-testid=year
      summary
        span = material_icon('arrow_right', classes: 'accordion__marker')
        span = year

      .op-stack
        .home-page
          = turbo_frame_tag "year_overview_#{year}", src: year_overview_path(year), loading: :lazy
          .home-page__footer
            = render 'pages/tax_breakdown', year:
          = link_to 'View Report', reports_path(year:), class: 'btn btn--no-border btn--min-width margin-auto'
