.card.card--padded
  = simple_form_for @transaction_form, html: { autocomplete: 'off', class: 'card__body' } do |f|
    div data-controller='conditional-input' data-conditional-input-condition-value='expense'
      = f.hidden_field :company_id, value: current_company.id

      .form-row
        = f.input :date, as: :string, input_html: { data: { controller: 'date-input' } }
        = f.input :amount, required: true, input_html: { value: f.object.amount || 0, data: { controller: 'money-input' } }
        = f.input :transaction_type, collection: transaction_type_options, include_blank: false, input_html: { data: { conditional_input_target: 'trigger' } }

      - options_for_categorizable = categorizable_options
      = f.input :categorizable, label: 'Category', collection: options_for_categorizable, selected: selected_categorizable_option(f.object, options_for_categorizable),
          include_blank: true,
          required: true,
          wrapper_html: { data: { conditional_input_target: 'conditionalInputWrapper' } },
          input_html: { data: {conditional_input_target: 'conditionalInput' } }
      = f.input :description

      - unless f.object.persisted?
        = render 'recurrence', transaction_form: f.object

  .card__footer
    - transaction = @transaction_form.transaction
    .flex.flex-wrap.justify-between.gap-xs
      - if transaction.persisted?
        - if policy(transaction).destroy?
          - if transaction.recurring?
            div data-controller='dialog'
              button.btn.btn--destructive type='button' data-action='dialog#open' Delete Transaction
              = render layout: 'occurrence_dialog', locals: { title: 'Delete Recurring Transaction', id: 'delete-occurrences' } do
                = button_to 'Only This Transaction', transaction_path(transaction), method: :delete, class: 'btn btn--destructive'
                = button_to 'This and Future Transactions', transaction_path(transaction), method: :delete, params: { occurrences: 'future' }, class: 'btn btn--destructive'
          - else
            = button_to 'Delete Transaction', transaction_path(transaction), method: :delete, data: { turbo_confirm: 'Are you sure?' }, class: 'btn btn--destructive'

        - if transaction.recurring?
          div data-controller='dialog'
            -# A real submit button placed before the dialog's, so pressing Enter in a field lands here and opens the
            -# dialog instead of submitting through "Only This Transaction".
            = submit_button @transaction_form, 'Update Transaction', class: 'btn btn--primary', data: { action: 'dialog#open:prevent' }
            = render layout: 'occurrence_dialog', locals: { title: 'Update Recurring Transaction', id: 'update-occurrences' } do
              = submit_button @transaction_form, 'Only This Transaction', name: 'transaction[occurrences]', value: 'this', class: 'btn btn--primary'
              = submit_button @transaction_form, 'This and Future Transactions', name: 'transaction[occurrences]', value: 'future', class: 'btn btn--primary'
        - else
          = submit_button @transaction_form, 'Update Transaction', class: 'btn btn--primary'
      - else
        .flex.flex-wrap.gap-xs
          = submit_button @transaction_form, 'Create Transaction', class: 'btn btn--primary'
          = submit_button @transaction_form, 'Create and New', class: 'btn', name: 'submit_and_new', value: 'true'
